---
import Logo from './Logo.astro';
import { web, menu, url } from '../data/web';
// Na podstránkách vedou kotvy zpět na úvodní stránku.
interface Props { home?: boolean }
const { home = true } = Astro.props;
const prefix = home ? '' : url();
---
<header class:list={['top', { 'top--over': home }]}>
  <div class="wrap">
    <a class="brand" href={`${prefix}#uvod`} aria-label={`${web.nazev} – ${web.osoba}, úvod`}>
      <Logo />
      <span class="brand__name">{web.nazev}</span>
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu">Menu</button>
    <nav class="nav" id="menu" aria-label="Hlavní menu">
      {menu.map((m) => <a class={m.cta ? 'nav__cta' : undefined} href={`${prefix}${m.href}`}>{m.label}</a>)}
    </nav>
  </div>
</header>

<script>
  const b = document.querySelector<HTMLButtonElement>('.menu-btn');
  const n = document.getElementById('menu');
  // Na úvodní stránce je hlavička průhledná přes hero, pozadí dostane po odscrollování nebo s otevřeným menu.
  const top = document.querySelector<HTMLElement>('.top--over');
  if (top) {
    // Pod hero sekcí přepneme lištu na světlou (is-light).
    const hero = document.getElementById('uvod');
    const solid = () => {
      top.classList.toggle('is-solid', scrollY > 24 || !!n?.classList.contains('open'));
      top.classList.toggle('is-light', !!hero && hero.getBoundingClientRect().bottom <= top.offsetHeight);
    };
    solid();
    addEventListener('scroll', solid, { passive: true });
    b?.addEventListener('click', () => requestAnimationFrame(solid));
  }
  // Aktuální sekce: odkaz v menu na sekci, jejíž horní okraj je nejblíž pod hlavičkou, dostane aria-current.
  // Na podstránkách (odkazy s cestou před #) se nic nevyznačuje.
  const odkazy = [...document.querySelectorAll<HTMLAnchorElement>('.nav a[href^="#"]')]
    .map((a) => ({ a, s: document.getElementById(a.hash.slice(1)) }))
    .filter((o): o is { a: HTMLAnchorElement; s: HTMLElement } => !!o.s);
  if (odkazy.length) {
    let ceka = false;
    const oznac = () => {
      ceka = false;
      const hranice = Math.max(120, innerHeight * 0.3);  // sekce je aktuální, jakmile zabere horní třetinu okna
      const naKonci = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
      // Nejníže položená sekce, která už dojela pod hlavičku (na konci stránky ta úplně poslední).
      let akt: HTMLAnchorElement | undefined, nej = -Infinity;
      for (const o of odkazy) {
        const t = o.s.getBoundingClientRect().top;
        if ((naKonci || t <= hranice) && t > nej) { nej = t; akt = o.a; }
      }
      for (const o of odkazy) o.a === akt ? o.a.setAttribute('aria-current', 'location') : o.a.removeAttribute('aria-current');
    };
    oznac();
    addEventListener('scroll', () => { if (!ceka) { ceka = true; requestAnimationFrame(oznac); } }, { passive: true });
    addEventListener('resize', oznac);
  }
  if (b && n) {
    const close = () => { n.classList.remove('open'); b.setAttribute('aria-expanded', 'false'); b.textContent = 'Menu'; };
    b.addEventListener('click', () => {
      const o = n.classList.toggle('open');
      b.setAttribute('aria-expanded', String(o));
      b.textContent = o ? 'Zavřít' : 'Menu';
    });
    n.addEventListener('click', (e) => { if ((e.target as HTMLElement).tagName === 'A' && n.classList.contains('open')) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && n.classList.contains('open')) { close(); b.focus(); } });
  }
</script>
