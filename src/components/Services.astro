---
import { Picture } from 'astro:assets';
import { sluzby } from '../data/obsah';
import sachta from '../assets/sluzba-vyrez-sachta.webp';
import plan from '../assets/sluzba-vyrez-plan.webp';
import kalendar from '../assets/sluzba-vyrez-kalendar.webp';
import stocne from '../assets/sluzba-vyrez-stocne.webp';
// Obrázky karet (předměty na průhledném pozadí) ve stejném pořadí jako sluzby.bloky.
const fotky = [sachta, plan, kalendar, stocne];
---
<section id="sluzby" class="section sluzby">
  <div class="wrap">
    <div class="sluzby__head">
      <h2>{sluzby.nadpis}</h2>
      <p class="lead">{sluzby.uvod}</p>
    </div>

    <div class="sluzby__grid">
      {sluzby.bloky.map((b, i) => (
        <article class:list={['sluzba', { 'sluzba--hlavni': b.hlavni }]}>
          <div class="sluzba__hlava">
            <Picture pictureAttributes={{ class: 'sluzba__foto' }} src={fotky[i]} alt="" formats={['avif', 'webp']} fallbackFormat="webp"
              widths={[480, 820]} sizes="(max-width: 720px) 100vw, 640px" loading="lazy" />
            <div class="sluzba__obsah">
              <h3>{b.nadpis}</h3>
              <p class="sluzba__text">{b.text}</p>
              <a class="sluzba__cta" href="#poptavka">{sluzby.pruh.tlacitko}</a>
            </div>
            <span class="sluzba__kdy">{b.kdy}</span>
          </div>
          <details class="sluzba__detail">
            <summary class="sluzba__rozbal"><span class="sr-only">Co zahrnuje: {b.nadpis}</span></summary>
            <ul class="sluzba__body">{b.body.map((li) => <li>{li}</li>)}</ul>
          </details>
        </article>
      ))}
    </div>

    <p class="sluzby__pozn">{sluzby.pruh.text}</p>
  </div>
</section>


<script>
  // Klik kamkoli do hlavičky karty rozbalí/sbalí podrobnosti (kromě tlačítka „Vyžádat nabídku").
  // Pro klávesnici a čtečky slouží <summary> se šipkou dole; bez JS funguje jen šipka.
  document.querySelectorAll<HTMLElement>('.sluzba__hlava').forEach((h) => {
    const d = h.closest('.sluzba')?.querySelector('details');
    if (!d) return;
    h.classList.add('sluzba__hlava--klik');
    h.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      d.open = !d.open;
    });
  });
</script>
