---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { web } from '../data/web';
import obec from '../assets/hero-obec-vysoka.webp';
import lide from '../assets/hero-jirka-starosta.webp';
import VykresSite from './VykresSite.astro';
---
<section id="uvod" class="hero">
  <div class="wrap hero__content">
    <h1>Kanalizace<br /><span>bez starostí</span></h1>
    <div class="hero__side">
      <p class="hero__sub">Odborné zastoupení provozovatele kanalizace, poradenství, evidence, hlášení a povolení pro obce. Převezmu agendu – vy se můžete věnovat obci.</p>
      <p class="hero__cred"><b>20 let</b> <span>praxe v provozování kanalizací <br />a čistíren odpadních vod</span></p>
      <p class="hero__jmeno">{web.osoba}</p>
      <div class="hero__cta">
        <a class="hbtn hbtn--lime" href={web.telefonHref}><Icon name="telefon" color="#102c40" />{web.telefon}</a>
        <a class="hbtn hbtn--ghost" href="#kontakt">Konzultace zdarma</a>
      </div>
    </div>
  </div>

  <div class="hero__media" aria-hidden="true">
    <div class="hero__canvas">
      <Picture src={obec} alt="" formats={['avif', 'webp']} fallbackFormat="webp" widths={[1000, 1500, 2000]}
        sizes="(max-width: 980px) 1600px, 190vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="hero__shade"></div>
    <div class="hero__canvas">
      <VykresSite />
    </div>
  </div>

  <div class="hero__lide">
    <Picture src={lide} alt="" formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 800, 1200]}
      sizes="(max-width: 980px) 80vw, 46vw" loading="eager" />
  </div>
</section>
