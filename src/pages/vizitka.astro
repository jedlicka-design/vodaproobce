---
// Tisková vizitka 90 × 50 mm (běžný český formát), oboustranná, spadávka 3 mm (stránka 96 × 56 mm), ve stylu letáku.
// PDF: spustit dev server (npm run dev) a pak `npm run vizitka` → ../Vizitka/Vizitka_90x50_spadavka3mm.pdf.
// Texty odsouhlasené v podkladu ../Vizitka/Incoming/Vizitka_podklad (beze změny).
import '@fontsource-variable/inter';
import { Image } from 'astro:assets';
import { web } from '../data/web';
import viko from '../assets/kalendar-vika.webp'; // víko kanálu v ročních obdobích (jako kalendář na webu)
---
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Vizitka – {web.nazev}</title>
  <script is:inline>if (new URLSearchParams(location.search).has('orez')) document.documentElement.classList.add('orez');</script>
  <style is:global>
    :root{--navy:#102c40;--white:#f7fafc;--lime:#dbff00;--muted:#4f5f6b;--na-tmave:rgba(247,250,252,.78);
      --sans:'Inter Variable',system-ui,sans-serif}
    @page{size:96mm 56mm;margin:0}
    *,*::before,*::after{box-sizing:border-box}
    html,body{margin:0;background:#cfd8df}
    body{font:400 8pt/1.4 var(--sans);color:var(--navy);-webkit-font-smoothing:antialiased;-webkit-print-color-adjust:exact;print-color-adjust:exact}
    h1,p{margin:0}
    a{color:inherit;text-decoration:none}

    /* strana vč. spadávky 3 mm; obsah drží odstup ≥ 5 mm od ořezu (8 mm od kraje stránky) */
    .strana{position:relative;width:96mm;height:56mm;overflow:hidden;break-after:page;display:flex;flex-direction:column;padding:9.5mm 9mm 8.5mm}
    .strana:last-child{break-after:auto}
    /* Náhled na obrazovce: výchozí je oříznutá vizitka 90 × 50 mm (bez spadávky).
       S parametrem ?orez (např. /vizitka/?orez) se ukáže celá tisková plocha se spadávkou a čarou ořezu.
       Tisk / PDF (npm run vizitka) má spadávku vždy, náhled ho neovlivní. */
    @media screen{
      .strana{margin:24px auto;box-shadow:0 10px 40px rgba(16,44,64,.25)}
      html:not(.orez) .strana{clip-path:inset(3mm);box-shadow:none;margin:-3mm auto;filter:drop-shadow(0 4px 14px rgba(16,44,64,.25))}
      html:not(.orez) body{padding:24px 0}
      html:not(.orez) .strana + .strana{margin-top:calc(-6mm + 24px)}
      html.orez .strana::after{content:"";position:absolute;inset:3mm;border:1px dashed rgba(220,40,40,.6);pointer-events:none}
    }

    /* Přední strana: světlá; jméno a role vlevo nahoře, kontakty vpravo dole (bez ikon) */
    .predni{background:#fff;justify-content:space-between}
    .predni h1{font:800 16pt/1.1 var(--sans);letter-spacing:-.03em}
    .role{margin-top:1.4mm;font:500 8pt/1.3 var(--sans);color:var(--muted)}
    .kontakty{align-self:flex-end;display:flex;flex-direction:column;align-items:flex-end;gap:1.4mm;font-size:10pt;line-height:1.2}
    .kontakty .tel{font-weight:700}
    .kontakty .web{font-weight:700}

    /* Zadní strana: navy, nadpis vlevo; vpravo celé víko kanálu bez přechodu,
       celé uvnitř ořezu (5 mm od čáry ořezu), aby se nikde neusekávalo */
    .zadni{background:var(--navy);color:var(--white);justify-content:center}
    .viko{position:absolute;right:8mm;top:50%;transform:translateY(-50%);width:38mm;height:38mm;border-radius:50%;object-fit:cover}
    .zadni h1{position:relative;font:800 18pt/1.04 var(--sans);letter-spacing:-.035em;color:var(--white)}
    .zadni h1 span{display:block;color:var(--lime)}
  </style>
</head>
<body>
  <section class="strana predni" aria-label="Přední strana">
    <div>
      <h1>{web.osoba}</h1>
      <p class="role">odborný zástupce provozovatele kanalizace</p>
    </div>
    <div class="kontakty">
      <a class="tel" href={web.telefonHref}>{web.telefon}</a>
      <a href={`mailto:${web.email}`}>{web.email}</a>
      <a class="web" href="https://vodaproobce.cz">vodaproobce.cz</a>
    </div>
  </section>

  <section class="strana zadni" aria-label="Zadní strana">
    <Image class="viko" src={viko} alt="" width={640} format="jpg" quality={85} />
    <h1>Kanalizace <span>bez starostí</span></h1>
  </section>
</body>
</html>
