---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4/opsz.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { web, url } from '../data/web';

interface Props { title?: string; description?: string; home?: boolean; noindex?: boolean }
const { title = web.title, description = web.description, home = true, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta name="theme-color" content="#0f3550">
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml">
  <link rel="sitemap" href={url('sitemap-index.xml')}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="cs_CZ">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
</head>
<body>
  <Header home={home} />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
